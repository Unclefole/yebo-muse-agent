# Meta Model API (get the key from your Meta developer account; hackathon credits apply)
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
META_MODEL=muse-spark-1.1

# Yebo gateway
YEBO_GATEWAY_URL=https://gateway.yebo.dev
# Shared secret that signs requests to the gateway's mission routes. Never commit the real value.
YEBO_HMAC_SECRET=
# Name shown to the human on the passkey approval page.
YEBO_BOT_IDENTIFIER=yebo-muse-agent
# Optional: reuse a mission token that was already approved instead of asking for a new one.
YEBO_MISSION_TOKEN=
