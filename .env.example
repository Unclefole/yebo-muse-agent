# Meta Model API (get the key from your Meta developer account; hackathon credits apply)
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
# Muse Spark reads the invoices (vision) and plans the payments. 1.3 is the docs' recommended model.
META_MODEL=muse-spark-1.3

# Yebo gateway.
# Leave YEBO_HMAC_SECRET empty to run in JUDGE MODE: a local stand-in gateway with the same
# mission rules and a simulated approval page, so you only need a Meta API key.
# Set it (the agent key issued for this project) to run against the real Yebo gateway.
YEBO_HMAC_SECRET=
YEBO_GATEWAY_URL=https://gateway.yebo.dev
# Optional: force "judge" or "live" regardless of YEBO_HMAC_SECRET.
YEBO_MODE=
# Optional: judge-mode port for the local gateway and approval page (default 4400).
YEBO_JUDGE_PORT=
# Name shown to the human on the approval page.
YEBO_BOT_IDENTIFIER=yebo-muse-agent
# Optional: reuse a mission token that was already approved instead of asking for a new one.
YEBO_MISSION_TOKEN=
# Optional: pin "today" (YYYY-MM-DD) so "pay this week's invoices" gives the same result in a demo.
YEBO_TODAY=

# Optional: Muse Spark Open (open weights) as the agent brain, served by Baseten.
# Get a key at https://app.baseten.co/settings/api_keys, then run: npm run check-open
BASETEN_API_KEY=
# Optional overrides (defaults shown in comments):
# MUSE_SPARK_OPEN_MODEL=meta-models/muse-spark-open
# MUSE_SPARK_OPEN_REASONING_EFFORT=medium        (low, medium, high, xhigh, or "default")
# BASETEN_API_BASE=https://inference.baseten.co/v1
