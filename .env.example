# Meta Model API (get the key from your Meta developer account; hackathon credits apply)
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
# Muse Spark reads the invoices (vision) and plans the payments. 1.3 is the docs' recommended model.
META_MODEL=muse-spark-1.3

# Yebo gateway.
# Leave YEBO_HMAC_SECRET empty to run in JUDGE MODE: a local stand-in gateway with the same
# mission rules and a simulated approval page, so you only need a Meta API key.
# Set it (the agent key issued for this project) to run against the real Yebo gateway.
YEBO_HMAC_SECRET=
YEBO_GATEWAY_URL=https://gateway.yebo.dev
# Optional: force "judge" or "live" regardless of YEBO_HMAC_SECRET.
YEBO_MODE=
# Optional: judge-mode port for the local gateway and approval page (default 4400).
YEBO_JUDGE_PORT=
# Name shown to the human on the approval page.
YEBO_BOT_IDENTIFIER=yebo-muse-agent
# Optional: reuse a mission token that was already approved instead of asking for a new one.
YEBO_MISSION_TOKEN=
# The vendor file: only vendors (and bank accounts) on it can be paid. Empty means the default,
# demo/vendors.json. Set a path to use your own file, or "off" to turn the check off.
YEBO_VENDORS=
# Optional: where spend for vendors with a 24-hour limit ("max_24h_usd") is kept. Empty means
# .data/vendor-ledger.json (gitignored). Reset it with: npm run ledger -- reset
YEBO_LEDGER=
# Optional: pin "today" (YYYY-MM-DD) so "pay this week's invoices" gives the same result in a demo.
YEBO_TODAY=

# Optional: Muse Spark Open (open weights), served by Baseten. In Open mode it plans, reads
# invoice images, checks for hidden payment requests and transcribes voice; PDFs are still
# read by Muse Spark 1.3 because Baseten does not accept PDFs.
# Get a key at https://app.baseten.co/settings/api_keys, then run: npm run check-open
BASETEN_API_KEY=
# Optional overrides (defaults shown in comments):
# MUSE_SPARK_OPEN_MODEL=meta-models/muse-spark-open   (the hackathon FAQ's -1026 ID gave 404 on Baseten, 2026-10-27)
# MUSE_SPARK_OPEN_REASONING_EFFORT=medium        (low, medium, high, xhigh, or "default")
# BASETEN_API_BASE=https://inference.baseten.co/v1

# Optional: record every finished web run as JSON (for replays): YEBO_RECORD_DIR=some/folder
# YEBO_RECORD_DIR=

# Hosted demo only (see HOSTING.md). Leave unset when running locally.
# YEBO_SITE=replay                 replay | live (live also needs META_API_KEY on the host)
# YEBO_LIVE=on                     "off" turns live runs off; the replays keep working
# YEBO_LIVE_DAILY_USD=5            hard daily cap on model spend, in US dollars (UTC day)
# YEBO_LIVE_RUNS_PER_VISITOR_PER_HOUR=3
# YEBO_LIVE_RUN_RESERVE_USD=0.5    held back for each run in progress
# YEBO_LIVE_MAX_CONCURRENT=2
# YEBO_TRUST_PROXY=true            behind Railway or Render, so each visitor is counted once
# YEBO_LIVE_SPEND_FILE=.data/live-spend.json
